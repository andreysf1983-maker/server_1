# ==========================================================================
#  LEGIONFORGE :: .env.example (корень проекта = веб-панель)
#  Скопируйте в .env и укажите свои значения.
# ==========================================================================

# Хранилище веб-панели (PostgreSQL + Drizzle ORM): настройки, магазин,
# реестр мировых боссов, фолианты, зеркало аккаунтов и телеметрия онлайна.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# Необязательно: корень платформы, если панель запускается не из него.
# По умолчанию определяется автоматически (ищет source\CMakeLists.txt
# или server\configs\worldserver.conf рядом с собой / уровнем выше).
# LEGIONFORGE_ROOT=C:\LEGIONFORGE

# Необязательно: живой мост к игровой MySQL/MariaDB (auth/characters/world/hotfixes).
# Если задано - server/mysql-bridge.mjs синхронизирует онлайн, аккаунты и валюту
# в хранилище панели каждые LEGIONFORGE_SYNC_INTERVAL секунд.
# Значения ниже соответствуют тому, что реально создаёт tools\bootstrap.ps1
# (портативная БД на порту 3307, пользователь legion).
LEGIONFORGE_MYSQL_HOST=127.0.0.1
LEGIONFORGE_MYSQL_PORT=3307
LEGIONFORGE_MYSQL_USER=legion
LEGIONFORGE_MYSQL_PASSWORD=change-me-before-production
LEGIONFORGE_MYSQL_DB_AUTH=legion_auth
LEGIONFORGE_MYSQL_DB_CHARACTERS=legion_characters
LEGIONFORGE_MYSQL_DB_WORLD=legion_world
LEGIONFORGE_SYNC_INTERVAL=15
