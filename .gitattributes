# ==========================================================================
#  LEGIONFORGE :: .gitattributes
#
#  ПЕРВОПРИЧИНА неработающих .bat: старое правило "* text=auto" заставляло
#  Git нормализовать ВСЕ текстовые файлы в LF, и при checkout на Windows
#  batch/PowerShell-скрипты получали LF-окончания строк. cmd.exe с LF ломает
#  разбор меток (goto/label), многострочных блоков в скобках и "if ... ( ... )",
#  поэтому START.bat / PANEL.bat / Stop.bat вели себя непредсказуемо.
#
#  Правило ниже жёстко закрепляет CRLF за всеми Windows-скриптами независимо
#  от core.autocrlf на машине разработчика.
# ==========================================================================

* text=auto

# --- Windows-скрипты: всегда CRLF -----------------------------------------
*.bat  text eol=crlf
*.cmd  text eol=crlf
*.ps1  text eol=crlf
*.psm1 text eol=crlf
*.psd1 text eol=crlf

# --- Unix-скрипты: всегда LF ----------------------------------------------
*.sh   text eol=lf

# --- Исходники ядра и конфиги: LF (как в TrinityCore) ---------------------
*.cpp  text eol=lf
*.h    text eol=lf
*.hpp  text eol=lf
*.c    text eol=lf
*.cc   text eol=lf
*.cmake text eol=lf
CMakeLists.txt text eol=lf

# --- Веб-панель: LF -------------------------------------------------------
*.ts   text eol=lf
*.tsx  text eol=lf
*.js   text eol=lf
*.mjs  text eol=lf
*.css  text eol=lf
*.json text eol=lf

# --- Текстовые данные -----------------------------------------------------
*.sql  text eol=lf
*.conf text eol=lf
*.dist text eol=lf
*.md   text eol=lf
*.txt  text eol=lf

# --- Бинарные файлы: не трогать -------------------------------------------
*.exe  binary
*.dll  binary
*.lib  binary
*.obj  binary
*.pdb  binary
*.zip  binary
*.7z   binary
*.gz   binary
*.png  binary
*.jpg  binary
*.ico  binary
*.bin  binary
